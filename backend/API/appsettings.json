{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Sobrescrito no Docker via variável de ambiente "ConnectionStrings__DefaultConnection".
    // Valores de exemplo - nunca commitar credenciais reais (ver .env.example).
    "DefaultConnection": "Host=localhost;Port=5432;Database=cyberprotech_lab;Username=postgres;Password=changeme"
  },
  "Database": {
    // Aplica as migrations pendentes na inicialização da API.
    "MigrateOnStartup": true,
    // Popula os usuários de exemplo do laboratório (apenas se a tabela estiver vazia).
    "Seed": true
  },
  "Jwt": {
    "Issuer": "cyberprotech-api",
    "Audience": "cyberprotech-web",
    // ATENÇÃO: valor de laboratório. Fora dele, definir "Jwt__SigningKey" no ambiente.
    "SigningKey": "dev-only-signing-key-troque-em-producao-0001",
    "ExpirationMinutes": 60
  },
  "Seed": {
    // Senha dos usuários de exemplo. Fora do laboratório, definir "Seed__Password".
    "Password": "CyberProtech@2026"
  },
  "Lab": {
    // Interruptor mestre. Mesmo ligado, os controles so ficam gravaveis em
    // ambiente de desenvolvimento (dupla trava em LabState.Writable).
    // O padrao e false: deploy com configuracao padrao nao expoe o modo vulneravel.
    "Enabled": false,
    // Estados iniciais dos quatro controles. Aqui a API esta inteira no estado
    // corrigido; a Sprint 5 ancora os cenarios atras destes flags.
    "VulnMode": false,
    "VerboseErrors": false,
    "RateLimit": true,
    "SecurityHeaders": true
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
