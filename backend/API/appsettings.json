{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    // Aplica as migrations pendentes na inicialização da API.
    "MigrateOnStartup": true,
    // Popula os usuários de exemplo do laboratório (apenas se a tabela estiver vazia).
    "Seed": true,
    // Conexões por processo. A conta é sempre: réplicas × pool < max_connections
    // do PostgreSQL (100 por padrão). Sobrescrever com "Database__MaxPoolSize".
    // O padrão do Npgsql é 100, que esgota o banco e impede qualquer outro
    // cliente de conectar — ver docs/load-test.md.
    "MaxPoolSize": 20
  },
  "Jwt": {
    "Issuer": "cyberprotech-api",
    "Audience": "cyberprotech-web",
    "ExpirationMinutes": 60
  },
  "Lab": {
    // Interruptor mestre. Mesmo ligado, os controles só ficam graváveis em
    // ambiente de desenvolvimento (dupla trava em LabState.Writable).
    // O padrão é false: deploy com configuração padrão não expõe o modo vulnerável.
    "Enabled": false,
    // Estados iniciais dos quatro controles. A Sprint 5 ancora os cenários atrás
    // destes flags; aqui a API está inteira no estado corrigido.
    "VulnMode": false,
    "VerboseErrors": false,
    "RateLimit": true,
    "SecurityHeaders": true
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  }
}
