# URL base da API (sem barra no final).
# Local: backend em http://localhost:5000 | Docker: http://localhost:5000 (porta publicada).
VITE_API_BASE_URL=http://localhost:5000

# Telas de usuários (login, lista, perfil) usam dados de exemplo fictícios
# enquanto a API não tem busca, bio e login. Mude para false quando tiver.
VITE_USE_SAMPLE_DATA=true
