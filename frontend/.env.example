# URL base da API (sem barra no final).
# Local: backend em http://localhost:5000 | Docker: backend publicado em 5000.
VITE_API_BASE_URL=http://localhost:5000

# true  -> telas de usuários usam dados fictícios (protótipo, sem API)
# false -> tudo vem da API real (login, perfil, área admin, laboratório)
#
# Com false, o login exige uma conta real do seed. A senha é a que você definiu
# em SEED_PASSWORD no .env da raiz (não há senha padrão versionada).
# (admin e carla.admin são Admin; os demais são User).
VITE_USE_SAMPLE_DATA=false