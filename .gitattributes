# Normaliza os finais de linha por tipo de arquivo.
#
# Sem isto, o git do Windows (core.autocrlf=true) grava CRLF ao fazer checkout
# de scripts shell, e o shebang vira "#!/usr/bin/env bash\r". O WSL e o Docker
# Linux passam a falhar com "env: $'bash\r': No such file or directory".
#
# Correto para quem trabalha no Windows com WSL, que e o caso da maior parte
# do time neste projeto.

*.sh text eol=lf
*.bash text eol=lf

# Dockerfile e compose também são interpretados por ferramentas que não
# toleram CRLF.
Dockerfile text eol=lf
*.Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.yml text eol=lf

# Configuração e código que o restante da stack consome como está.
*.cs text eol=lf
*.json text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.md text eol=lf

# Binários: nunca traduzir.
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary