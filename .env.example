# Copie para `.env` (não versionado) e ajuste localmente. Nunca commitar senhas reais.
# cp .env.example .env   (Git Bash / WSL)  |  Copy-Item .env.example .env   (PowerShell)

# As três segredos abaixo são OBRIGATÓRIOS e não têm valor padrão: o compose
# usa `${VAR:?}` e aborta antes de criar qualquer container se alguma ficar
# vazia. Por isso estão vazios aqui de propósito — um placeholder tipo
# "troque-esta-senha" passaria pela checagem e só falharia depois, com o
# backend em crash loop tentando conectar no Postgres.
#
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)
#   JWT_SIGNING_KEY=$(openssl rand -base64 48)
#   SEED_PASSWORD=<senha que você vai usar no login>

# PostgreSQL (serviço `db` do compose).
POSTGRES_DB=cyberprotech_lab
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Portas publicadas no host (evitam conflito com serviços locais).
BACKEND_PORT=5000
FRONTEND_PORT=5173
# Porta do PostgreSQL publicada no host. Necessária para `dotnet ef database
# update`, psql/pgAdmin e a suíte de testes de integração a partir da máquina.
# Troque (ex.: 5433) se já houver um PostgreSQL local na 5432.
DB_PORT=5432

# URL pública do frontend (usada pelo CORS do backend).
FRONTEND_URL=http://localhost:5173

# Chave de assinatura do JWT (mínimo 32 caracteres). Gere por ambiente:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Senha dos usuários de exemplo criados pelo seed do backend.
# Trocar isto depois NÃO muda as contas já existentes: o seed só popula quando
# o banco está vazio. Para recomeçar do zero: docker compose down -v.
SEED_PASSWORD=

# Interruptor mestre do laboratório de segurança.
# "true" permite alternar os controles (modo vulnerável, erros detalhados,
# limite de login, headers). A gravação também exige ambiente de Development.
# Fora do laboratório, deixe "false".
LAB_ENABLED=true

# Frontend (build). O Vite assa import.meta.env.* no build, então isto precisa
# mudar aqui E o frontend precisa ser reconstruido (--build).
VITE_API_BASE_URL=http://localhost:5000
# false = o login e as telas usam a API real. true = dados fictícios.
VITE_USE_SAMPLE_DATA=false
